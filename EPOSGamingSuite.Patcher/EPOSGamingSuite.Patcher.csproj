<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net461</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EPOSGamingSuite.Patcher</AssemblyName>
    <RootNamespace>EPOSGamingSuite.Patcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Title>EPOS Gaming Suite Community Patch Installer</Title>
    <Product>EPOS Gaming Suite Community Patch</Product>
    <Company>nil-commits</Company>
    <Copyright>Copyright (c) 2026 nil-commits (MIT License)</Copyright>
    <Description>Clean-room Lib.Harmony runtime patch installer for EPOS Gaming Suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

</Project>
